# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Dipakai oleh aplikasi web (aman dipublikasikan, dilindungi oleh RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-anon-key-here

# Hanya untuk skrip setup_db.js (RAHASIA — akses penuh ke database)
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
